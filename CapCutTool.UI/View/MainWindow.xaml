<Window x:Class="CapCutTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CapCutTool.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button  Command="{Binding ClickAnimationCommand}" Width="Auto" Height="32" >
                <Button.Content>
                    Chèn Animation
                </Button.Content>
            </Button>
            <TextBlock Width="auto" Height="32" Text="{Binding StatusAnimation}" Padding="5"/>
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Command="{Binding ClickEffectCommand}" Width="Auto" Height="32" >
                <Button.Content>
                    Chèn Effect
                </Button.Content>
            </Button>
            <TextBlock Width="auto" Height="32" Text="{Binding StatusEffect}" Padding="5"/>
        </StackPanel>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Command="{Binding ClickTransitionCommand}" Width="Auto" Height="32" >
                <Button.Content>
                    Chèn Transition
                </Button.Content>
            </Button>
            <TextBlock Width="auto" Height="32" Text="{Binding StatusTransition}" Padding="5"/>
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Grid.Row="2" Command="{Binding ClickSyncVoidCommand}" Width="Auto" Height="32" >
                <Button.Content>
                    Đồng Bộ Âm Thanh
                </Button.Content>
            </Button>
            <TextBlock Grid.Row="0" Width="auto" Height="32" Text="{Binding StatusSyncVoice}" Padding="5"/>
        </StackPanel>
    </Grid>

</Window>
