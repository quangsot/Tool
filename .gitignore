*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*_i.asm
*_p.asm
*.cachefile
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings

# Other
*.docstates
*.appx
*.appxbundle
*.appxupload
*.appxsym
*.appxrecipe
*.appxmanifest

# Local History for Visual Studio
.localhistory/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# VS Code directories
.vscode/
.history/

# DotCover
.idea.DotSettings

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Azure Functions
local.settings.json

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# JetBrains Rider
*.sln.iml
.idea/

# Mac
.DS_Store

# Backup & Report
*.bak
*.backup
*.report.xml
